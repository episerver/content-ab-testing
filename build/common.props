<Project>
    <PropertyGroup>
        <Product Condition=" '$(Product)' == '' ">EPiServer.Marketing.Testing</Product>
        <Company>Optimizely</Company>
        <Authors>Optimizely</Authors>
        <Copyright>© 2003-2019 by Optimizely. All rights reserved</Copyright>
        <PackageTags>EPiServer.Marketing.Testing</PackageTags>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <NoWarn>NU5125;CS1591</NoWarn>
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0022;RS0024;RS0025;RS0026;RS0027</WarningsAsErrors>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    </PropertyGroup>
    <ItemGroup>
        <!-- Pin vulnerable transitive dependencies (CVE-2018-8292, CVE-2019-0820). -->
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    </ItemGroup>
</Project>